# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.

# --- Proxy LiteLLM de la universidad (obligatorio) ---
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Nombre según el proxy (GET /models). En octubre de 2026 el alias corto 'gpt-4.1-mini' dejó de
# funcionar y el mismo modelo quedó como 'openai/gpt-4.1-mini'.
LLM_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Dimensión de salida del modelo de embeddings (scripts/check_services.py la informa)
EMBEDDING_DIM=1536
# Método de salida estructurada que soporta el modelo de chat del proxy:
# function_calling | json_schema | json_mode (scripts/check_services.py indica cuál funciona)
LLM_STRUCTURED_METHOD=function_calling

# --- Pinecone (obligatorio) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mas-2026s2-tables
# Ubicación del índice serverless (el plan gratuito solo admite aws / us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LangSmith (obligatorio) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mas-2026s2-<tu-legajo>

# --- Sandbox de ejecución de código ---
# auto: usa Docker si está disponible, si no un subproceso
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT_S=30
# Imagen de Docker del sandbox (construirla con: docker build -t mas-tp-sandbox sandbox/)
SANDBOX_IMAGE=mas-tp-sandbox

# --- Agentes ---
INGEST_MAX_RETRIES=2
ANALYST_MAX_RETRIES=3
RETRIEVAL_K=6

# --- Desarrollo ---
# true: cachea respuestas del LLM y embeddings en .cache/ para no gastar presupuesto del proxy
LLM_CACHE=true
DATA_DIR=data/store
